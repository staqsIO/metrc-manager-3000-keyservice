# openssl rand -hex 32 - clients send it as a Bearer token
KEY_SERVICE_API_KEY=
KEYSERVICE_DATABASE_URL=postgresql://metrc:change-me@postgres:5432/keyservice
# openssl rand -hex 32 - never change after storing keys
KEYSERVICE_ENCRYPTION_KEY=
PORT=3001
# Browser origins allowed via CORS (comma separated); empty = none
ALLOWED_ORIGINS=
